<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests du moteur de détection et du planificateur, sans Jellyfin ni dépendance NuGet :
       lancer : dotnet run (dans ce dossier) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.MediaUploader.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Jellyfin.Plugin.MediaUploader\Configuration\DetectionRule.cs" />
    <Compile Include="..\Jellyfin.Plugin.MediaUploader\Configuration\DefaultRules.cs" />
    <Compile Include="..\Jellyfin.Plugin.MediaUploader\Services\PathBuilder.cs" />
    <Compile Include="..\Jellyfin.Plugin.MediaUploader\Services\Detection\*.cs" />
    <Compile Include="..\Jellyfin.Plugin.MediaUploader\Services\Planner\*.cs" />
  </ItemGroup>

</Project>
